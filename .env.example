# Required account and appointment settings
PUID=1000
PGID=1000
USER_EMAIL=
USER_PASSWORD=
EARLIEST_ACCEPTABLE_DATE=2026-01-01
LATEST_ACCEPTABLE_DATE=2026-12-31
USER_CONSULATE=Vancouver
NUM_PARTICIPANTS=1

# Keep this true until you have verified the complete flow in the logs.
TEST_MODE=true
SHOW_GUI=false

# Optional generic SMTP notifications
SMTP_HOST=
SMTP_PORT=587
# One of: starttls, ssl, none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Optional Telegram Bot notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Temporarily enable this to verify configured notification channels on startup.
NOTIFY_ON_STARTUP=false

# Legacy Gmail settings (still supported for backwards compatibility)
GMAIL_SENDER_NAME=
GMAIL_EMAIL=
GMAIL_APPLICATION_PWD=
RECEIVER_NAME=
RECEIVER_EMAIL=

# Optional excluded date ranges (up to 9)
# EXCLUSION_START_DATE_1=2026-06-01
# EXCLUSION_END_DATE_1=2026-06-10
